{
  "name": "qwksearch-extension-wxt",
  "description": "QwkSearch Tab Manager AI",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "overrides": {
    "@vitejs/plugin-react": "6.0.3"
  },
  "scripts": {
    "dev": "bun x wxt",
    "dev:firefox": "bun x wxt -b firefox",
    "build": "bun x wxt build",
    "build:firefox": "bun x wxt build -b firefox",
    "zip": "bun x wxt zip",
    "zip:firefox": "bun x wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "precompile": "bun x wxt prepare",
    "test": "vitest run",
    "test:coverage": "bun x wxt prepare && vitest run --coverage",
    "pretest": "bun x wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "research-agent-ui": "workspace:*",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "6.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wxt": "^0.21.4",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  },
  "license": "rights.institute/PROSPER"
}
