{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // TypeScript 7 no longer infers the common source directory (TS5011).
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "vite.config.ts"]
}
