{
  "name": "qwksearch-extension-wxt",
  "description": "QwkSearch Tab Manager AI",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "overrides": {
    "@vitejs/plugin-react": "6.0.3"
  },
  "scripts": {
    "dev": "bun x wxt",
    "dev:firefox": "bun x wxt -b firefox",
    "build": "bun x wxt build",
    "build:firefox": "bun x wxt build -b firefox",
    "zip": "bun x wxt zip",
    "zip:firefox": "bun x wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "bun x wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "6.0.3",
    "@wxt-dev/module-react": "1.2.2",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wxt": "^0.20.27"
  },
