{
  "name": "qwksearch-web",
  "description": "Search, extract, vectorize, outline graph, and monitor the web for topic keywords",
  "version": "2.5.0",
  "author": "vtempest",
  "license": "rights.institute/PROSPER",
  "type": "module",
  "scripts": {
    "dev": "npx open-ready next dev",
    "prebuild": "node ../../.github/scripts/build-workspace-packages.mjs",
    "build": "vinext build",
    "deploy": "vinext deploy",
    "start": "next start",
    "dev:cf": "vinext build && npx wrangler dev --local",
    "collab": "bun run collaboration/server.ts",
    "collab:dev": "bun run --watch collaboration/server.ts",
    "preview": "NODE_OPTIONS='--max-old-space-size=4096' next build && next start",
    "deploy:staging": "NODE_OPTIONS='--max-old-space-size=4096' vinext build && vinext deploy --env staging",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --config drizzle.d1.config.ts",
    "db:migrate": "wrangler d1 migrations apply qwksearch-new --remote",
    "db:migrate:local": "wrangler d1 migrations apply qwksearch-new --local",
    "db:migrate:status": "wrangler d1 migrations list qwksearch-new --remote",
    "db:studio": "drizzle-kit studio",
    "db:create": "bun x create cloud-db",
    "analyze": "ANALYZE=true next build --webpack",
    "favicon": "bun create favicon public/favicon-512.png public/ --overwrite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
