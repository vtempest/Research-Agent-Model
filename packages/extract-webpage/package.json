{
  "name": "extract-webpage",
  "version": "1.2.361",
  "module": "./dist/extract-webpage.es.js",
  "description": "Search, extract, cite, and outline the web for a topic with AI Research Agent.",
  "author": "vtempest <grokthiscontact@gmail.com>",
  "license": "rights.institute/PROSPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/extract-webpage"
  },
  "main": "./dist/extract-webpage.cjs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/extract-webpage.es.js",
      "require": "./dist/extract-webpage.cjs.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "react-server": "./src/*",
      "import": "./src/*",
      "require": "./src/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "ship": "npm run build && npx standard-version --release-as patch; rm CHANGELOG.md; npm publish",
    "test-ui": "vitest --ui --watch",
    "test:coverage": "vitest run --coverage",
    "make": "rm -rf dist/*; NODE_OPTIONS=--max-old-space-size=15192 BUN_JSC_forceRAMSize=15192  vite build "
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.51.2",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.94",
    "chat-agent-toolkit": "workspace:*",
    "chrono-node": "^2.10.1",
    "drizzle-orm": "^0.45.2",
    "extract-pdf": "workspace:*",
    "extract-youtube": "workspace:*",
    "html-entities": "^2.6.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "marked": "^18.0.12",
    "marked-highlight": "^2.2.4",
    "node-fetch": "^3.3.2",
    "prismjs": "^1.30.0",
    "qwksearch-api-client": "^0.9.225",
    "zod": "^4.5.4"
  },
  "keywords": [
    "nlp",
    "autocomplete",
    "knowledge-graph",
    "keywords",
    "search-algorithm",
    "hacktoberfest",
    "mind-map",
    "ai-search"
  ]
}
