# ============================================================================
# App URLs
# ============================================================================

# Public base URL for your app.
# Local example: http://localhost:3000
# Production example: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================================
# Collaborative editing (collaboration/)
# ============================================================================

# WebSocket origin of the Hocuspocus server that ships with this app
# (`bun run collab:dev`). Unset, the REASON editor is single-player.
# Local example: ws://127.0.0.1:1234
# Production example: wss://collab.yourdomain.com
# NEXT_PUBLIC_HOCUSPOCUS_URL=

# Read by that server, not by the Worker: the origin it verifies connection
# tokens and document access against — this app. Required there in production.
# QWKSEARCH_API_URL=http://localhost:3000

# Shared secret proving a request to /api/collaboration/access came from that
# server. Set the same value on both sides; generate one with
#   openssl rand -base64 32
# Unset, /api/collaboration/access refuses to answer in production.
# REASON_COLLAB_SECRET=

# ============================================================================
# Better Auth / Session Secrets
# ============================================================================

# Random secret used by Better Auth for signing/encryption.
# Generate locally, do not fetch from a provider.
# Example command:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_long_random_secret

# Additional origins allowed to make authenticated requests, comma-separated.
# The apex domain, its subdomains (e.g. beta.), and http://localhost:3000 are
# trusted by default; add any other hosts (preview URLs, custom domains) here.
# Example: https://staging.example.com,https://app.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=

# ============================================================================
# Discord OAuth
# ============================================================================

# Discord OAuth Client ID
# Get it from:
# https://discord.com/developers/applications
# Steps: create/select app -> OAuth2 / General Information -> Client ID
AUTH_DISCORD_ID=your_discord_client_id

# Discord OAuth Client Secret
# Get it from:
# https://discord.com/developers/applications
# Steps: create/select app -> OAuth2 / General Information -> Client Secret
AUTH_DISCORD_SECRET=your_discord_client_secret

# ============================================================================
# LinkedIn OAuth
# ============================================================================

# LinkedIn OAuth Client ID
# Get it from LinkedIn developer app settings.
# Start here:
# https://www.linkedin.com/developers/
AUTH_LINKEDIN_ID=your_linkedin_client_id

# LinkedIn OAuth Client Secret
# Get it from LinkedIn developer app settings.
# Start here:
# https://www.linkedin.com/developers/
AUTH_LINKEDIN_SECRET=your_linkedin_client_secret

# ============================================================================
# Google OAuth
# ============================================================================

# Google OAuth Client ID
# Get it from:
# https://console.cloud.google.com/
# Docs:
# https://support.google.com/googleapi/answer/6158849
# Steps: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Google OAuth Client Secret
# Get it from:
# https://console.cloud.google.com/
# Docs:
# https://support.google.com/googleapi/answer/6158849
# Steps: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ============================================================================
# Email / Resend
# ============================================================================

# Resend API key
# Get it from:
# https://resend.com/api-keys
AUTH_RESEND_KEY=your_resend_api_key

# ============================================================================
# Admin Access
# ============================================================================

# Comma-separated list of email addresses allowed to access /admin.
# The admin panel (and admin API routes) are ONLY accessible to these
# emails — if unset, nobody has admin access.
# Both ADMIN_EMAILS and legacy ADMIN_EMAIL are supported (values are merged).
# ADMIN_EMAILS=you@example.com,cofounder@example.com

# ============================================================================
# LLM / AI Providers
# ============================================================================

# AnyAPI API key
# Free plan includes 100,000 anyTokens/day (resets daily, no credit card)
# with access to free/basic models.
# Get it from:
# https://anyapi.ai/pricing
ANYAPI_API_KEY=your_anyapi_api_key

# DeepSeek API key
# Get it from your DeepSeek platform dashboard / API keys page.
DEEPSEEK_API_KEY=your_deepseek_api_key

# NVIDIA API key
# Get it from your NVIDIA API catalog / build platform account.
NVIDIA_API_KEY=your_nvidia_api_key

# OOMOL API key
# Get it from your OOMOL account / dashboard.
# IMPORTANT: rotate any real key that was pasted in chat.
OOMOL_API_KEY=your_oomol_api_key

# OpenRouter API key
# Get it from:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Tavily API key
# Get it from:
# https://app.tavily.com/
# Docs:
# https://docs.tavily.com/documentation/quickstart
TAVILY_API_KEY=your_tavily_api_key

# ============================================================================
# Homepage widgets
# ============================================================================

# The News API key, for the homepage trending-news widget (served by
# /api/news/trending, so the key never reaches the browser). Without it the
# widget simply doesn't render.
# Get it from:
# https://www.thenewsapi.com/
THENEWSAPI_API_KEY=your_thenewsapi_api_key

# ============================================================================
# Cloudflare Turnstile (first-load bot gate)
# ============================================================================

# Optional. With both keys unset the gate never runs and the app behaves
# exactly as before. Set both to challenge a desktop browser's first HTML page
# view once; phones, crawlers, /api/*, assets and RSC fetches are never
# challenged. See the "Turnstile first-load gate" architecture doc.
# Create a Managed widget at https://dash.cloudflare.com → Turnstile.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional. "false" switches the gate off while keeping the keys in place.
# TURNSTILE_ENABLED=

# Optional. How long one pass lasts, in seconds. Default 604800 (7 days),
# clamped to 5 minutes - 30 days.
# TURNSTILE_TTL_SECONDS=

# Optional. Share one pass across subdomains, e.g. .qwksearch.com
# TURNSTILE_COOKIE_DOMAIN=
