{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "react-reason-editor": ["./src/index.ts"],
      "react-reason-editor/theme": ["./src/theme/theme.ts"],
      "react-reason-editor/docs-agent": ["./src/docs-agent.ts"],
      "react-reason-editor/locale-bundle": ["./src/locale-bundle.ts"],
      "react-reason-editor/bubble": ["./src/bubble.ts"],
      "react-reason-editor/attachment": ["./src/extensions/Attachment/index.ts"],
      "react-reason-editor/blockquote": ["./src/extensions/Blockquote/index.ts"],
      "react-reason-editor/bold": ["./src/extensions/Bold/index.ts"],
      "react-reason-editor/bulletlist": ["./src/extensions/BulletList/index.ts"],
      "react-reason-editor/callout": ["./src/extensions/Callout/index.ts"],
      "react-reason-editor/clear": ["./src/extensions/Clear/index.ts"],
      "react-reason-editor/code": ["./src/extensions/Code/index.ts"],
      "react-reason-editor/codeblock": ["./src/extensions/CodeBlock/index.ts"],
      "react-reason-editor/codeview": ["./src/extensions/CodeView/index.ts"],
      "react-reason-editor/color": ["./src/extensions/Color/index.ts"],
      "react-reason-editor/column": ["./src/extensions/Column/index.ts"],
      "react-reason-editor/drawer": ["./src/extensions/Drawer/index.ts"],
      "react-reason-editor/emoji": ["./src/extensions/Emoji/index.ts"],
      "react-reason-editor/exportpdf": ["./src/extensions/ExportPdf/index.ts"],
      "react-reason-editor/exportword": ["./src/extensions/ExportWord/index.ts"],
      "react-reason-editor/fontfamily": ["./src/extensions/FontFamily/index.ts"],
      "react-reason-editor/fontsize": ["./src/extensions/FontSize/index.ts"],
      "react-reason-editor/heading": ["./src/extensions/Heading/index.ts"],
      "react-reason-editor/highlight": ["./src/extensions/Highlight/index.ts"],
      "react-reason-editor/history": ["./src/extensions/History/index.ts"],
      "react-reason-editor/horizontalrule": ["./src/extensions/HorizontalRule/index.ts"],
      "react-reason-editor/iframe": ["./src/extensions/Iframe/index.ts"],
      "react-reason-editor/image": ["./src/extensions/Image/index.ts"],
      "react-reason-editor/imagegif": ["./src/extensions/ImageGif/index.ts"],
      "react-reason-editor/importword": ["./src/extensions/ImportWord/index.ts"],
      "react-reason-editor/indent": ["./src/extensions/Indent/index.ts"],
      "react-reason-editor/italic": ["./src/extensions/Italic/index.ts"],
      "react-reason-editor/katex": ["./src/extensions/Katex/index.ts"],
      "react-reason-editor/lineheight": ["./src/extensions/LineHeight/index.ts"],
      "react-reason-editor/link": ["./src/extensions/Link/index.ts"],
      "react-reason-editor/markdownpaste": ["./src/extensions/MarkdownPaste/index.ts"],
      "react-reason-editor/mention": ["./src/extensions/Mention/index.ts"],
      "react-reason-editor/mermaid": ["./src/extensions/Mermaid/index.ts"],
      "react-reason-editor/moremark": ["./src/extensions/MoreMark/index.ts"],
      "react-reason-editor/orderedlist": ["./src/extensions/OrderedList/index.ts"],
      "react-reason-editor/searchandreplace": ["./src/extensions/SearchAndReplace/index.ts"],
      "react-reason-editor/slashcommand": ["./src/extensions/SlashCommand/index.ts"],
      "react-reason-editor/strike": ["./src/extensions/Strike/index.ts"],
      "react-reason-editor/table": ["./src/extensions/Table/index.ts"],
      "react-reason-editor/tasklist": ["./src/extensions/TaskList/index.ts"],
      "react-reason-editor/textalign": ["./src/extensions/TextAlign/index.ts"],
      "react-reason-editor/textdirection": ["./src/extensions/TextDirection/index.ts"],
      "react-reason-editor/textunderline": ["./src/extensions/TextUnderline/index.ts"],
      "react-reason-editor/twitter": ["./src/extensions/Twitter/index.ts"],
      "react-reason-editor/video": ["./src/extensions/Video/index.ts"],
      "react-reason-editor/wordcount": ["./src/extensions/WordCount/index.ts"]
    }
  },
  "include": ["src"]
}
