{
  "name": "chat-agent-toolkit",
  "version": "1.2.367",
  "description": "Multi-provider AI agent toolkit: generate language responses, search the web, extract content, and manage memory across 10+ LLM providers.",
  "author": "vtempest <grokthiscontact@gmail.com>",
  "license": "rights.institute/PROSPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/chat-agent-toolkit"
  },
  "bugs": {
    "url": "https://github.com/OpenSourceAGI/qwksearch-research-agent/issues"
  },
  "main": "./dist/research-agent.cjs.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/research-agent.es.js",
      "require": "./dist/research-agent.cjs.js"
    },
    "./connectors": {
      "types": "./src/connectors/index.ts",
      "import": "./src/connectors/index.ts",
      "require": "./src/connectors/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "react-server": "./src/*",
      "import": "./src/*",
      "require": "./src/*"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "src/connectors/*.json",
    "src/connectors/server.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test-ui": "vitest --ui --watch",
    "make": "rm -rf dist/*; NODE_OPTIONS=--max-old-space-size=15192 vite build",
    "ship": "npx standard-version --release-as patch && npm publish --access public"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "vinext": ">=0.1.0 || >=1.0.0-0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vinext": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "terser": "^5.51.2",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@oomol-lab/connector": "^1.2.0",
    "express": "^5.2.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.50",
    "@ai-sdk/google": "^4.0.65",
    "@ai-sdk/groq": "^4.0.38",
    "@ai-sdk/mcp": "^2.0.46",
    "@ai-sdk/openai": "^4.0.62",
    "@mastra/core": "^1.65.0",
    "@mastra/mcp": "^1.17.3",
    "@mastra/memory": "^1.28.3",
    "ai": "^7.0.94",
    "drizzle-orm": "^0.45.2",
    "prismjs": "^1.30.0",
    "html-entities": "^2.6.0",
    "manage-storage": "^0.0.47",
    "marked": "^18.0.12",
    "qwksearch-api-client": "workspace:*",
    "write-language": "^0.1.153",
    "zod": "^4.5.4"
  },
  "keywords": [
    "ai-agent",
    "llm",
    "research-agent",
    "vercel-ai-sdk",
    "nlp",
    "web-search",
    "knowledge-graph",
    "multi-provider",
    "groq",
    "openai",
    "anthropic",
    "ollama",
    "hacktoberfest"
  ],
  "publishConfig": {
    "access": "public"
  }
}
